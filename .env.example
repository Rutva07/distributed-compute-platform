POSTGRES_DB=compute
POSTGRES_USER=compute
POSTGRES_PASSWORD=compute
DATABASE_URL=postgres://compute:compute@postgres:5432/compute?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_STREAM=compute:jobs
REDIS_GROUP=compute-workers
HTTP_ADDR=:8080
WORKER_CONCURRENCY=16
DISPATCH_BATCH_SIZE=100
DISPATCH_POLL_MS=100
JOB_LEASE_SECONDS=120
MAX_JOB_SECONDS=30
DB_MAX_CONNS=12
